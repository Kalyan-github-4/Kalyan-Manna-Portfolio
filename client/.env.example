# Read by the client at BUILD time — Next inlines NEXT_PUBLIC_* values into the
# bundle, so these must be set before `next build` runs, not just at runtime.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
NEXT_PUBLIC_API_URL=https://kalyan-manna-developer.onrender.com
NEXT_PUBLIC_CAL_LINK=kalyanmanna/30min

# Server-side secrets (CLERK_SECRET_KEY, DATABASE_URL, ...) belong in
# server/.env — never here. Anything added with a NEXT_PUBLIC_ prefix is
# embedded in the JavaScript sent to every visitor.
