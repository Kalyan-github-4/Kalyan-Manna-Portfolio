# Read at BUILD time — Next inlines NEXT_PUBLIC_* values into the bundle, so
# these must be set before `next build` runs, not just at runtime. Anything with
# a NEXT_PUBLIC_ prefix is embedded in the JavaScript sent to every visitor.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
NEXT_PUBLIC_CAL_LINK=kalyanmanna/30min

# Server-only secrets, read at runtime by the route handlers in src/app/api.
# Put real values in .env.local (gitignored) and in the host's environment
# settings. Never give these a NEXT_PUBLIC_ prefix.

DATABASE_URL=postgresql://user:password@host/db
CLERK_SECRET_KEY=sk_test_xxxx
ADMIN_EMAIL=you@example.com
